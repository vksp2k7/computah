# Copy to .env, restrict it to your user (chmod 600 .env), then fill in locally.
#
# System One backend (Jev cloud or local CLM):
#   Cloud (default): leave endpoint/model blank or set the TypeSafe values.
#   Local CLM:       SYSTEM_ONE_ENDPOINT=http://127.0.0.1:8700/v1/systemone
#                    SYSTEM_ONE_MODEL=clm-latest
#                    TYPESAFE_API_KEY can be empty for unauthenticated local servers.
SYSTEM_ONE_ENDPOINT=https://api.typesafe.ai/v1/systemone
SYSTEM_ONE_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
DEEPGRAM_API_KEY=
